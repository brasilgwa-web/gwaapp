{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/upload-drive.js": {
            "maxDuration": 30
        },
        "api/sync-lab-reports.js": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}